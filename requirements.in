# Direct dependencies. Edit this file, then regenerate the pinned lock:
#
#   pip-compile requirements.in -o requirements.txt
#
# or, without pip-tools:
#
#   docker run --rm -v "$PWD:/w" -w /w python:3.12-slim sh -c \
#     "pip install -q -r requirements.in && pip freeze" > requirements.txt
#
# requirements.txt is what the Dockerfile installs. Never install requirements.in
# directly in an image — unpinned transitive dependencies make builds
# irreproducible and have already caused a production incident (a stale
# remnawave SDK silently stopped parsing panel v2.8 host responses).

