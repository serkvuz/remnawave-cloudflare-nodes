# Remnawave panel URL and API key
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_API_KEY=remnawave_api_key
# Cloudflare Access (Zero Trust) service token, only if the panel is behind Access
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Cloudflare token with DNS edit permissions
CLOUDFLARE_API_TOKEN=cloudflare_api_token

# API
API_ENABLED=false
API_TOKEN=  # Generate a strong random value: openssl rand -hex 32
API_HOST=0.0.0.0
API_PORT=8741
API_DOCS=false

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=123456789
TELEGRAM_TOPIC_ID=  # Forum topic ID (leave empty for regular chats)

# Bot commands (/status, /reload, /pause, /resume, /maintenance, /summary).
# Only TELEGRAM_CHAT_ID can use them; in a group, TELEGRAM_COMMAND_USERS can
# restrict them further to these Telegram user IDs (comma-separated).
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_COMMAND_USERS=

# Notification filters
TELEGRAM_NOTIFY_NODE_CHANGES=true
TELEGRAM_NOTIFY_DNS_CHANGES=true
TELEGRAM_NOTIFY_ERRORS=true
TELEGRAM_NOTIFY_CRITICAL=true
TELEGRAM_NOTIFY_API_CHANGES=true
TELEGRAM_NOTIFY_DISCOVERY=true  # nodes auto-added to config.yml (see auto-discovery in config.yml)
TELEGRAM_NOTIFY_MAINTENANCE=true  # maintenance start/end, DNS pause/resume

# Host sync: automatically disable Remnawave hosts whose address has no DNS A record in Cloudflare
DISABLE_UNREACHABLE_HOSTS=false
TELEGRAM_NOTIFY_HOST_CHANGES=true

# Language for notifications (en, ru)
LANGUAGE=en
# Timezone (e.g. UTC, Europe/Moscow, America/New_York)
TIMEZONE=UTC
# Time format: %d-day, %m-month, %Y-year, %H-hour, %M-min, %S-sec
TIME_FORMAT="%d.%m.%Y %H:%M:%S"
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Where node/host transition state is persisted across restarts. config.yml
# backups (taken before every rewrite) go in config-backups/ next to it.
# Must be on a mounted volume, otherwise state is lost when the container is recreated.
STATE_FILE=data/state.json
